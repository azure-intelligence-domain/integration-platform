<!-- Product "agents": every agent subscription may make at most 60 calls per minute. -->
<policies>
  <inbound>
    <base />
    <rate-limit calls="60" renewal-period="60" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
